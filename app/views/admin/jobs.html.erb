<% content_for :title, "Admin • Jobs" %>
<% content_for :page, "admin" %>

<header class="topbar">
  <nav class="nav">
    <a class="nav__item" href="/projects">← Back to Projects</a>
    <a class="nav__item nav__item--active" href="/admin">Admin</a>
  </nav>
  <div class="topbar__right">
    <span class="muted">Admin: <%= @current_user.slack_username || @current_user.email %></span>
  </div>
</header>

<main class="container">
  <div style="display: flex; gap: 1rem; margin-bottom: 2rem; border-bottom: 1px solid #e0e0e0; padding-bottom: 1rem;">
    <a href="/admin/projects" style="padding: 8px 16px; border-bottom: 2px solid transparent; color: #999; text-decoration: none; font-weight: 600;">Projects</a>
    <a href="/admin/users" style="padding: 8px 16px; border-bottom: 2px solid transparent; color: #999; text-decoration: none; font-weight: 600;">Users</a>
    <a href="/admin/shop" style="padding: 8px 16px; border-bottom: 2px solid transparent; color: #999; text-decoration: none; font-weight: 600;">Shop</a>
    <a href="/admin/jobs" style="padding: 8px 16px; border-bottom: 2px solid #f25f2c; color: #f25f2c; text-decoration: none; font-weight: 600;">Jobs</a>
  </div>

  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
    <h1 class="page-title" style="margin: 0;">Background Jobs</h1>
    <%= button_to "Run All Airtable Syncs", admin_run_airtable_sync_path, method: :post, class: "btn btn--primary" %>
  </div>

  <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 2rem;">
    <div style="background: #e8f5e9; padding: 1.5rem; border-radius: 8px; text-align: center;">
      <div style="font-size: 2rem; font-weight: 700; color: #2e7d32;"><%= @ready_jobs %></div>
      <div style="color: #666; font-size: 0.9rem;">Ready</div>
    </div>
    <div style="background: #fff3e0; padding: 1.5rem; border-radius: 8px; text-align: center;">
      <div style="font-size: 2rem; font-weight: 700; color: #ef6c00;"><%= @scheduled_jobs %></div>
      <div style="color: #666; font-size: 0.9rem;">Scheduled</div>
    </div>
    <div style="background: #ffebee; padding: 1.5rem; border-radius: 8px; text-align: center;">
      <div style="font-size: 2rem; font-weight: 700; color: #c62828;"><%= @failed_jobs %></div>
      <div style="color: #666; font-size: 0.9rem;">Failed</div>
    </div>
    <div style="background: #e3f2fd; padding: 1.5rem; border-radius: 8px; text-align: center;">
      <div style="font-size: 2rem; font-weight: 700; color: #1565c0;"><%= @completed_jobs %></div>
      <div style="color: #666; font-size: 0.9rem;">Completed</div>
    </div>
  </div>

  <% if @recent_ready.any? %>
    <h2 style="margin: 2rem 0 1rem; font-size: 1.25rem;">Ready (Waiting to Process)</h2>
    <div class="admin-table">
      <div style="display: grid; grid-template-columns: 2fr 2fr 1fr; gap: 1rem; padding: 12px 16px; background: #e8f5e9; font-weight: 600; border-radius: 8px 8px 0 0; font-size: 0.9rem;">
        <div>Job Class</div>
        <div>Arguments</div>
        <div>Queued At</div>
      </div>

      <% @recent_ready.each do |ready| %>
        <div style="display: grid; grid-template-columns: 2fr 2fr 1fr; gap: 1rem; padding: 12px 16px; border-bottom: 1px solid #e0e0e0; align-items: center;">
          <div>
            <strong><%= ready.job.class_name %></strong>
          </div>
          <div class="muted" style="font-size: 0.85rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
            <%= truncate(ready.job.arguments.to_json, length: 50) %>
          </div>
          <div class="muted">
            <%= ready.created_at.strftime("%b %d, %H:%M") %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if @recent_failed.any? %>
    <h2 style="margin: 2rem 0 1rem; font-size: 1.25rem;">Failed Jobs</h2>
    <div class="admin-table">
      <div style="display: grid; grid-template-columns: 2fr 1fr 2fr 1fr; gap: 1rem; padding: 12px 16px; background: #ffebee; font-weight: 600; border-radius: 8px 8px 0 0; font-size: 0.9rem;">
        <div>Job Class</div>
        <div>Failed At</div>
        <div>Error</div>
        <div>Actions</div>
      </div>

      <% @recent_failed.each do |failed| %>
        <div style="display: grid; grid-template-columns: 2fr 1fr 2fr 1fr; gap: 1rem; padding: 12px 16px; border-bottom: 1px solid #e0e0e0; align-items: center;">
          <div>
            <strong><%= failed.job.class_name %></strong>
          </div>
          <div class="muted">
            <%= failed.created_at.strftime("%b %d, %H:%M") %>
          </div>
          <div style="font-size: 0.85rem; color: #c62828; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="<%= failed.error.dig('message') %>">
            <%= truncate(failed.error.dig('message').to_s, length: 60) %>
          </div>
          <div style="display: flex; gap: 0.5rem;">
            <%= button_to "Retry", admin_retry_job_path(failed.id), method: :post, class: "btn btn--primary", style: "padding: 4px 8px; font-size: 0.8rem;" %>
            <%= button_to "Discard", admin_discard_job_path(failed.id), method: :delete, class: "btn btn--ghost", style: "padding: 4px 8px; font-size: 0.8rem;", data: { confirm: "Are you sure?" } %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if @recent_scheduled.any? %>
    <h2 style="margin: 2rem 0 1rem; font-size: 1.25rem;">Scheduled Jobs</h2>
    <div class="admin-table">
      <div style="display: grid; grid-template-columns: 2fr 2fr 1fr; gap: 1rem; padding: 12px 16px; background: #fff3e0; font-weight: 600; border-radius: 8px 8px 0 0; font-size: 0.9rem;">
        <div>Job Class</div>
        <div>Arguments</div>
        <div>Scheduled For</div>
      </div>

      <% @recent_scheduled.each do |scheduled| %>
        <div style="display: grid; grid-template-columns: 2fr 2fr 1fr; gap: 1rem; padding: 12px 16px; border-bottom: 1px solid #e0e0e0; align-items: center;">
          <div>
            <strong><%= scheduled.job.class_name %></strong>
          </div>
          <div class="muted" style="font-size: 0.85rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
            <%= truncate(scheduled.job.arguments.to_json, length: 50) %>
          </div>
          <div class="muted">
            <%= scheduled.scheduled_at.strftime("%b %d, %H:%M") %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if @recent_completed.any? %>
    <h2 style="margin: 2rem 0 1rem; font-size: 1.25rem;">Recently Completed</h2>
    <div class="admin-table">
      <div style="display: grid; grid-template-columns: 2fr 2fr 1fr; gap: 1rem; padding: 12px 16px; background: #e3f2fd; font-weight: 600; border-radius: 8px 8px 0 0; font-size: 0.9rem;">
        <div>Job Class</div>
        <div>Arguments</div>
        <div>Finished At</div>
      </div>

      <% @recent_completed.each do |job| %>
        <div style="display: grid; grid-template-columns: 2fr 2fr 1fr; gap: 1rem; padding: 12px 16px; border-bottom: 1px solid #e0e0e0; align-items: center;">
          <div>
            <strong><%= job.class_name %></strong>
          </div>
          <div class="muted" style="font-size: 0.85rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
            <%= truncate(job.arguments.to_json, length: 50) %>
          </div>
          <div class="muted">
            <%= job.finished_at.strftime("%b %d, %H:%M") %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</main>
